# Dépendances et artefacts locaux
/vendor/
/node_modules/

# Application
/var/*
!/var/.gitkeep
!/var/database/
/var/database/*
!/var/database/.gitkeep
!/var/media/
/var/media/*
!/var/media/.gitkeep
!/var/cache/
/var/cache/*
!/var/cache/.gitkeep
!/var/log/
/var/log/*
!/var/log/.gitkeep
!/var/tmp/
/var/tmp/*
!/var/tmp/*/

# Cache d'outils (var/)
var/cache/php-cs-fixer.cache

# Fichiers locaux sensibles ou éphémères (le projet n'utilise pas .env : le secret
# vit dans var/app.secret ou la variable APP_SECRET — voir README / docs)
/.phpunit.cache/
/.phpunit.result.cache
/.php-cs-fixer.cache
.env
.env.*
!.env.example
