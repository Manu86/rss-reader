{
    "name": "RSS Reader",
    "short_name": "RSS Reader",
    "description": "Lecteur RSS et Atom personnel, rapide et installable.",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "display_override": ["standalone", "fullscreen"],
    "background_color": "#1264a3",
    "theme_color": "#f4f6f8",
    "lang": "fr",
    "icons": [
        {
            "src": "/assets/icons/icon-192-v2.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/assets/icons/icon-192-maskable-v2.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/assets/icons/icon-512-v2.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/assets/icons/icon-512-maskable-v2.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}
